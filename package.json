{
  "name": "chook-check",
  "version": "0.2.0",
  "description": "Track Australian supermarket prices from Woolworths and Coles",
  "license": "MIT",
  "author": "Nevenit <Nevenit@outlook.com>",
  "homepage": "https://github.com/Nevenit/Chook-Check",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nevenit/Chook-Check.git"
  },
  "bugs": {
    "url": "https://github.com/Nevenit/Chook-Check/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "audit:build": "node scripts/audit-build.mjs",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "test": "node scripts/run-tests.mjs",
    "test:run": "node scripts/run-tests.mjs run",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "dexie": "^4.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.10",
    "wxt": "^0.20.27"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "esbuild": "0.28.1",
    "shell-quote": "1.10.0",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  },
  "engines": {
    "node": "24.x"
  }
}
